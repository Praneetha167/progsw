YACC program (parser.y)
  ---------------------
  
%{
#include <stdio.h>
int yylex();
void yyerror(const char *s);
%}

%token NUMBER
%left '+' '-'
%left '*' '/'
%right UMINUS

%%

input:
      expression '\n' { printf("Valid Arithmetic Expression\n"); }
    ;

expression:
      NUMBER
    | expression '+' expression
    | expression '-' expression
    | expression '*' expression
    | expression '/' expression
    | '(' expression ')'
    | '-' expression %prec UMINUS
    ;

%%

void yyerror(const char *s)
{
    printf("Invalid Arithmetic Expression\n");
}

int main()
{
    printf("Enter an arithmetic expression: ");
    yyparse();
    return 0;
}

  ---------------------------------------------------------------
  Lex program (lexer.l)
    ----------------------
    
%{
#include "y.tab.h"
%}

%%

[0-9]+(\.[0-9]+)?    { return NUMBER; }
[ \t]                ;
\n                   { return '\n'; }
[()+*/-]             { return yytext[0]; }
.                    { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}
