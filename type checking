Lex program (type.l)
------------------------------

%{
#include "y.tab.h"
%}

%%

i       { yylval.type = 1; return ID; }
f       { yylval.type = 2; return ID; }
[+*]    { return yytext[0]; }
[ \t\n]+ ;
.       { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}
