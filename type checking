YACC program (type.y)
----------------------

%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%union {
    int type;
}

%token <type> ID
%type <type> expr

%%

input : expr {
            if ($1 == 1)
                printf("Expression type: INTEGER\n");
            else if ($1 == 2)
                printf("Expression type: FLOAT\n");
        }
      ;

expr : ID { $$ = $1; }
     | expr '+' expr {
            if ($1 == $3)
                $$ = $1;
            else {
                printf("Type Error: Incompatible types\n");
                YYABORT;
            }
        }
     | expr '*' expr {
            if ($1 == $3)
                $$ = $1;
            else {
                printf("Type Error: Incompatible types\n");
                YYABORT;
            }
        }
     ;

%%

void yyerror(const char *s)
{
    printf("Invalid expression\n");
}

int main()
{
    printf("Type checking: 1 = INTEGER, 2 = FLOAT\n");
    printf("Enter expression using i (integer) and f (float): ");
    yyparse();
    return 0;
}
