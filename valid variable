Lex program (lexer.l)
  ----------------

%{
#include "y.tab.h"
%}

%%

[a-zA-Z_][a-zA-Z0-9_]*    { return VALID; }
[ \t\n]                  ;
.                        { return INVALID; }

%%

int yywrap()
{
    return 1;
}
