%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%union {
    int type;
}

%token <type> NUM
%type <type> expr

%%

expr : NUM '+' NUM
       {
           if ($1 == 1 && $3 == 1)
               printf("Type: int\n");
           else if ($1 == 2 && $3 == 2)
               printf("Type: float\n");
           else
               printf("Type Error: Incompatible types\n");
       }
     ;

%%

void yyerror(const char *s)
{
    printf("Invalid Expression\n");
}

int main()
{
    printf("Enter expression: ");
    yyparse();
    return 0;
}
