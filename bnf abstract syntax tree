%{
#include "y.tab.h"
%}

%%

[a-zA-Z]    { yylval.ch = yytext[0]; return ID; }
[ \t]       ;
\n          { return '\n'; }
.           { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}
