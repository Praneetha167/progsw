variable.y
--
%{
#include <stdio.h>
#include <stdlib.h>

int yylex();
void yyerror(char *s);
%}

%token VALID

%%

input:
    VALID '\n'     { printf("Valid variable\n"); }
    ;

%%

void yyerror(char *s)
{
    printf("Invalid variable\n");
}

int main()
{
    printf("Enter a variable: ");
    yyparse();
    return 0;
}

